# Optional: enables the "Suggest improvements" AI button. Copy to .env and fill in.
ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL=claude-sonnet-5

# Optional: Wikimedia asks API clients to identify themselves, e.g. MyTeamLab/1.0 (you@example.com)
WIKI_USER_AGENT=WikiLangCompare/1.0 (your-email@example.com)
